 "html": "{%- set inv = invoice_context(doc) -%}\n<style>\n\t.acm-invoice { font-size: 12px; color: #1f2937; }\n\t.acm-invoice h1 { font-size: 22px; margin: 0 0 4px; color: #1b5e3a; }\n\t.acm-invoice .muted { color: #6b7280; }\n\t.acm-invoice table { width: 100%; border-collapse: collapse; }\n\t.acm-invoice .meta td { padding: 2px 0; vertical-align: top; }\n\t.acm-invoice .parties td { width: 50%; padding: 10px 12px 10px 0; vertical-align: top; }\n\t.acm-invoice .label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; }\n\t.acm-invoice .lines th { text-align: left; border-bottom: 2px solid #1b5e3a; padding: 6px 4px; font-size: 11px; }\n\t.acm-invoice .lines td { border-bottom: 1px solid #e5e7eb; padding: 8px 4px; }\n\t.acm-invoice .num { text-align: right; }\n\t.acm-invoice .total td { border-bottom: none; font-weight: bold; font-size: 14px; padding-top: 10px; }\n</style>\n<div class=\"acm-invoice\">\n\t<table class=\"meta\">\n\t\t<tr>\n\t\t\t<td>\n\t\t\t\t<h1>Invoice</h1>\n\t\t\t\t<div class=\"muted\">Accreage Mart</div>\n\t\t\t</td>\n\t\t\t<td class=\"num\">\n\t\t\t\t<div><strong>Invoice no:</strong> {{ inv.invoice_no or \"\" }}</div>\n\t\t\t\t<div><strong>Date:</strong> {{ inv.invoice_date }}</div>\n\t\t\t\t<div><strong>Order no:</strong> {{ inv.order_no }}</div>\n\t\t\t\t<div class=\"muted\">{{ inv.source }}</div>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\t<table class=\"parties\">\n\t\t<tr>\n\t\t\t<td>\n\t\t\t\t<div class=\"label\">Seller</div>\n\t\t\t\t<div><strong>{{ inv.seller.business_name }}</strong></div>\n\t\t\t\t{% if inv.seller.contact %}<div>{{ inv.seller.contact }}</div>{% endif %}\n\t\t\t\t{% if inv.seller.address %}<div class=\"muted\">{{ inv.seller.address }}</div>{% endif %}\n\t\t\t</td>\n\t\t\t<td>\n\t\t\t\t<div class=\"label\">Buyer</div>\n\t\t\t\t<div><strong>{{ inv.buyer.business_name or inv.buyer.contact }}</strong></div>\n\t\t\t\t{% if inv.buyer.business_name and inv.buyer.contact %}<div>{{ inv.buyer.contact }}</div>{% endif %}\n\t\t\t\t{% if inv.buyer.address %}<div class=\"muted\">{{ inv.buyer.address }}</div>{% endif %}\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\t<table class=\"lines\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th>Item</th>\n\t\t\t\t<th class=\"num\">Quantity</th>\n\t\t\t\t<th>Unit</th>\n\t\t\t\t<th class=\"num\">Unit price</th>\n\t\t\t\t<th class=\"num\">Amount</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t<tr>\n\t\t\t\t<td>{{ inv.item }}</td>\n\t\t\t\t<td class=\"num\">{{ inv.quantity }}</td>\n\t\t\t\t<td>{{ inv.unit }}</td>\n\t\t\t\t<td class=\"num\">{{ inv.unit_price }}</td>\n\t\t\t\t<td class=\"num\">{{ inv.total }}</td>\n\t\t\t</tr>\n\t\t\t<tr class=\"total\">\n\t\t\t\t<td colspan=\"4\" class=\"num\">Total</td>\n\t\t\t\t<td class=\"num\">{{ inv.total }}</td>\n\t\t\t</tr>\n\t\t</tbody>\n\t</table>\n\t<p class=\"muted\" style=\"margin-top: 24px;\">\n\t\tPaid by bank transfer directly to the seller{% if inv.paid_on %} (payment approved {{ inv.paid_on }}){% endif %}.\n\t\t{% if inv.delivered_on %}Delivered {{ inv.delivered_on }}.{% endif %}\n\t</p>\n</div>\n",
